{
  "batch": "logic_20261128",
  "hypothesis": "用 Logical 算子（and/or/not/if_else + 比较运算 + trade_when）做事件门控，而不是继续换因子窗口：核心假设是同一信号在不同状态下胜率不同，门控能提升信噪比并压低换手。第一组验证价量状态（放量反转、放量动量、close-vwap 强弱、压力反转、跳空回补）；第二组把逻辑门加在 FwdEP/新闻/社媒/偏斜上；第三组用 trade_when 把日报冠军配方改成只在放量日调仓，测试低换手版本。全部 Delay1 / USA / MARKET / trunc 0.01，单项 TOP1000 筛查、成品 TOP200。",
  "defaults": {
    "region": "USA",
    "universe": "TOP1000",
    "delay": 1,
    "neutralization": "MARKET",
    "decay": 10,
    "truncation": 0.01,
    "nanHandling": "OFF",
    "pasteurization": "ON",
    "unitHandling": "VERIFY"
  },
  "items": [
    {
      "label": "L_if_volrev",
      "expression": "if_else(volume > adv20, rank(-ts_rank(returns, 5)), 0)",
      "settings": {"decay": 10},
      "priority": 0.62
    },
    {
      "label": "L_tw_volrev",
